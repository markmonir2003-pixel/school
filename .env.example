# ── St. George School Digital Campus — Environment Configuration ───────────────
# الحرم الرقمي لمدرسة سان جورج

# Database storage path (defaults to ./data/school.db)
SCHOOL_DB_PATH=./data/school.db

# Application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=production

# Server Session Configuration
SESSION_SECRET=st-george-secure-session-key-change-this-in-production-min-32-chars

# File Storage & Uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,docx,xlsx,png,jpg,jpeg,mp4,zip

# Outbound School Email (SMTP)
SMTP_HOST=smtp.stgeorgeschool.edu
SMTP_PORT=587
SMTP_USER=notifications@stgeorgeschool.edu
SMTP_PASS=your-secure-smtp-password
SMTP_FROM="St. George School Digital Campus" <notifications@stgeorgeschool.edu>

# Rate Limiting & Security
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_WINDOW_MINUTES=10
